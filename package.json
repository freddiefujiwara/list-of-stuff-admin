{
  "name": "list-of-stuff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build:staging": "vite build --mode staging --outDir dist-staging && cp dist-staging/index.html dist-staging/404.html",
    "test:staging": "playwright test e2e/staging.check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/compiler-sfc": "^3.4.38",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "vite": "^5.4.8",
    "vitest": "^4.0.17",
    "vue": "^3.4.38"
  }
}
