{
  "name": "list-of-stuff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "test": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "build:staging": "vite build --mode staging --outDir dist-staging && cp dist-staging/index.html dist-staging/404.html",
    "test:staging": "playwright test e2e/staging.check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
